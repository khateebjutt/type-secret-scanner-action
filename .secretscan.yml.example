# Copy this file to .secretscan.yml at your repo root to customize scanning.

ignore:
  # File paths / globs to skip entirely (simple * wildcard supported)
  paths:
    - "test/fixtures/**"
    - "docs/examples/**"
    - "**/*.test.js"

  # Exact string values to allow (e.g. known-fake keys used in tests/docs)
  strings:
    - "AKIAEXAMPLE0000000"
    - "sk_live_EXAMPLE_NOT_REAL_KEY"
